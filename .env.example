# ──────────────────────────────────────────────────────────────────────────────
# DocLens — Environment Configuration Example
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control — it contains secrets.
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL (Supabase / any PostgreSQL instance) ───────────────────────────
# Transaction-mode pooler URL recommended for serverless/containerised deployments
DATABASE_URL=postgresql://user:password@host:5432/database

# ── JWT (Authentication) ──────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# MUST be ≥32 characters. Never use the example value in production.
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=7d

# ── Google sign-in (optional) ─────────────────────────────────────────────────
# OAuth 2.0 "Web application" client from Google Cloud Console → APIs & Services → Credentials.
# GOOGLE_CLIENT_ID alone enables the Google Identity Services popup button
# (add the site origin, e.g. http://localhost:8080, under "Authorized JavaScript origins").
# Add GOOGLE_CLIENT_SECRET + GOOGLE_CALLBACK_URL to switch to the server-side redirect flow
# (authorization code + PKCE). GOOGLE_CALLBACK_URL must be listed under "Authorized redirect URIs"
# and must be on the same origin the browser uses for the API, e.g.
#   Docker:  http://localhost:8080/api/v1/auth/google/callback
#   Render:  https://<backend>.onrender.com/api/v1/auth/google/callback
# FRONTEND_URL is where the callback sends the browser back (no trailing slash);
# leave empty when the frontend and API share an origin (Docker/nginx).
# Leave all empty to hide the "Continue with Google" button. Never commit the secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
FRONTEND_URL=

# ── Admin seed account ────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@doclens.ai
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── Internal service secret (NestJS ↔ FastAPI) ────────────────────────────────
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# ── Gemini (Google AI) API key ────────────────────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
# IMPORTANT: The key in the repository must be ROTATED if it was ever committed.
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY

# ── LLM model ─────────────────────────────────────────────────────────────────
# Options: gemini-2.5-flash, gemini-2.5-pro (any Gemini chat model id)
LLM_MODEL=gemini-2.5-flash
# Build an evidence-linked paper profile with Gemini at ingest (falls back to extractive)
PAPER_PROFILE_ENABLED=true
# Section-aware chunk size / sentence overlap (characters)
CHUNK_MAX_CHARS=2000
CHUNK_OVERLAP_CHARS=300

# ── Latency / retrieval knobs ─────────────────────────────────────────────────
# Candidates scored by the cross-encoder per request (it dominates CPU latency)
RERANK_CANDIDATES=20
# Token limit per (question, chunk) pair for the reranker; chunks are ~350 tokens
RERANKER_MAX_LENGTH=512
# false = skip the cross-encoder and rank by fused RRF (much faster, lower quality)
RERANKER_ENABLED=true
# Router section boost added to reranker scores; 0 = off (it lowered recall)
ROUTER_SECTION_BOOST=0
# No-relevant-evidence floor: abstain before calling Gemini when the best
# retrieved chunk's BGE-M3 cosine is below this (calibrated 2026-10-24 on the
# eval set: answerable >= 0.55, off-topic <= 0.44). 0 disables it.
RETRIEVAL_MIN_SIMILARITY=0.48
# Same for the cross-encoder score when the reranker runs. Not calibrated; 0 = off.
RETRIEVAL_MIN_RERANK=0
# Load BGE models in the background at AI-service startup
MODEL_WARMUP=true
# Gemini per-call timeout (seconds) and retry count
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=1
# Gemini timeout (seconds) for compare / literature review / gap analysis (long prompts)
SYNTHESIS_LLM_TIMEOUT_S=100
# Max cross-encoder pairs per multi-paper task, split across papers (~1.1 s per pair on CPU)
SYNTHESIS_RERANK_BUDGET=60
# Backend → AI service request timeout (ms); keep below nginx proxy_read_timeout (300 s)
AI_REQUEST_TIMEOUT_MS=180000
# Backend timeout (ms) for synthesis endpoints; keep below nginx 300 s
AI_SYNTHESIS_TIMEOUT_MS=280000

# Extract table structure and summarize captioned figures during ingestion.
# Disable for text-only or low-cost deployments.
VISION_ENABLED=true
VISION_MAX_PAGES=12

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * to allow all (not recommended for production)
# Example: https://doclens.yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=*
